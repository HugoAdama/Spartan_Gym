---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import TickerBand from "../components/TickerBand.astro";
import Classes from "../components/Classes.astro";
import Stats from "../components/Stats.astro";
import Schedule from "../components/Schedule.astro";
import Coaches from "../components/Coaches.astro";
import Pricing from "../components/Pricing.astro";
import CTA from "../components/CTA.astro";
import Footer from "../components/Footer.astro";
import FreePassModal from "../components/FreePassModal.astro";
---

<Layout
  title="SPARTAN GYM | Tu mejor versión empieza hoy"
  description="Entrena con entrenadores certificados en SPARTAN GYM. Sala de pesas, funcional, boxeo y spinning. Reclama tu primera clase 100% gratis hoy mismo."
>
  <Header />
  <main id="contenido-principal">
    <Hero />
    <TickerBand />
    <Classes />
    <Stats />
    <Schedule />
    <Coaches />
    <Pricing />
    <CTA />
  </main>
  <Footer />
  <FreePassModal />
</Layout>
