---
import { statsData } from "../data/stats";
---

<section class="numbers">
  <div class="numbers-grid">
    {statsData.map((item) => (
      <div class="stat-card">
        <span class="num">{item.value}</span>
        <span class="label">{item.label}</span>
        <span class="detail">{item.detail}</span>
      </div>
    ))}
  </div>
</section>

<style>
  .numbers {
    background: var(--ink);
    color: #fff;
    padding: clamp(48px, 7vw, 84px) var(--pad);
    border-top: 1px solid var(--border-dark);
    border-bottom: 1px solid var(--border-dark);
  }

  .numbers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 36px;
    max-width: 1440px;
    margin: 0 auto;
    text-align: center;
  }

  .stat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    padding: 12px;
  }

  .stat-card:not(:last-child)::after {
    content: '';
    position: absolute;
    right: -18px;
    top: 20%;
    height: 60%;
    width: 1px;
    background: rgba(255, 255, 255, 0.1);
  }

  .num {
    font: 400 clamp(64px, 8vw, 102px) var(--display);
    color: var(--red);
    display: block;
    line-height: 1;
    margin-bottom: 8px;
    text-shadow: 0 4px 20px rgba(214, 47, 15, 0.35);
  }

  .label {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 18px;
    font-weight: 800;
    color: #fff;
    margin-bottom: 6px;
  }

  .detail {
    font-size: 15px;
    color: #A5A5A5;
    font-weight: 500;
  }

  @media (max-width: 768px) {
    .stat-card:not(:last-child)::after {
      display: none;
    }
  }
</style>
