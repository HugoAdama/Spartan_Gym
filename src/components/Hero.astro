---
import Icon from "./ui/Icon.astro";
import { gymConfig } from "../data/gym";
---

<section class="hero" id="inicio">
  <div class="hero-text">
    <div class="hero-badge">
      <span class="badge-dot"></span>
      <span>TEMPLO DE DISCIPLINA & FUERZA</span>
    </div>

    <h1>Tu mejor versión <em class="hero-em">empieza hoy.</em></h1>

    <p class="lead">
      Entrena con entrenadores certificados que corrigen tu técnica, te motivan y te exigen tu máximo potencial.
      Sin vergüenza, a tu ritmo, en la mejor comunidad fitness.
    </p>

    <div class="actions">
      <button class="btn hero-btn" type="button" data-open-modal>
        <span>Reserva tu clase gratis</span>
        <Icon name="arrow-right" size={18} />
      </button>
      <a class="btn btn-line hero-btn" href="#planes">Ver planes</a>
    </div>

    <div class="hero-perks">
      <div class="perk-item">
        <Icon name="check" size={18} class="check-icon" />
        <span>1ª Clase de prueba gratuita</span>
      </div>
      <div class="perk-item">
        <Icon name="check" size={18} class="check-icon" />
        <span>Coaches en sala siempre</span>
      </div>
      <div class="perk-item">
        <Icon name="check" size={18} class="check-icon" />
        <span>Sin permanencia obligatoria</span>
      </div>
    </div>
  </div>

  <div class="hero-visual">
    <div class="hero-image-wrapper">
      <img
        src="/images/hero.jpg"
        alt={`Atleta entrenando intensamente en ${gymConfig.name}`}
        class="hero-img"
        width="900"
        height="600"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero-overlay"></div>
      
      <!-- Floating Spartan Card -->
      <div class="floating-badge">
        <div class="rating-stars" aria-label="Calificación 5 estrellas">
          <Icon name="star" size={15} />
          <Icon name="star" size={15} />
          <Icon name="star" size={15} />
          <Icon name="star" size={15} />
          <Icon name="star" size={15} />
        </div>
        <strong>4.9 / 5.0</strong>
        <span>Comunidad Spartan Activa</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--paper);
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: stretch;
    position: relative;
    overflow: hidden;
    border-bottom: 3px solid var(--ink);
  }

  .hero-text {
    padding: clamp(48px, 7vw, 100px) var(--pad);
    display: flex;
    flex-direction: column;
    gap: 24px;
    justify-content: center;
    z-index: 2;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(214, 47, 15, 0.1);
    color: var(--red);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: 99px;
    width: fit-content;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--red);
    animation: pulse 1.8s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }

  .hero h1 {
    font-size: clamp(48px, 6.8vw, 102px);
    line-height: 0.95;
    color: var(--ink);
    letter-spacing: 0.01em;
  }

  .hero-em {
    font-style: normal;
    color: var(--red);
    display: block;
  }

  .lead {
    font-size: clamp(17px, 1.8vw, 20px);
    line-height: 1.55;
    max-width: 520px;
    color: var(--gray);
  }

  .actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  .hero-btn {
    padding: 14px 32px;
    font-size: 16px;
  }

  .hero-perks {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 24px;
    margin-top: 12px;
    padding-top: 24px;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  .perk-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
  }

  :global(.check-icon) {
    color: var(--red);
    flex-shrink: 0;
  }

  .hero-visual {
    position: relative;
    min-height: 480px;
    display: flex;
  }

  .hero-image-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    clip-path: polygon(10% 0, 100% 0, 100% 100%, 0 100%);
    overflow: hidden;
    background: var(--ink);
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s ease;
  }

  .hero:hover .hero-img {
    transform: scale(1.02);
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(20, 20, 20, 0.15) 0%, rgba(20, 20, 20, 0.45) 100%);
    pointer-events: none;
  }

  .floating-badge {
    position: absolute;
    bottom: 32px;
    right: 32px;
    background: rgba(20, 20, 20, 0.92);
    color: #fff;
    padding: 16px 20px;
    border-left: 4px solid var(--red);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(8px);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .rating-stars {
    color: var(--color-gold);
    display: flex;
    gap: 3px;
    align-items: center;
    margin-bottom: 2px;
  }

  .floating-badge strong {
    font-size: 22px;
    font-family: var(--display);
    letter-spacing: 0.04em;
  }

  .floating-badge span {
    font-size: 12px;
    color: #BBB;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media (max-width: 960px) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero-image-wrapper {
      clip-path: none;
      min-height: 380px;
    }

    .hero-visual {
      min-height: 380px;
    }

    .floating-badge {
      bottom: 20px;
      right: 20px;
    }
  }
</style>
