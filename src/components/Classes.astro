---
import Icon from "./ui/Icon.astro";
import SectionHead from "./ui/SectionHead.astro";
import { classesData } from "../data/classes";
---

<section id="clases" class="section">
  <SectionHead
    eyebrow="Qué puedes hacer"
    title="Clases para todos los niveles"
    description="Tanto si es tu primer día en un gimnasio como si buscas batir tus récords personales, nuestros programas están diseñados para acompañarte paso a paso."
  />

  <div class="grid">
    {classesData.map((item) => (
      <article class="card">
        <div class="card-image-wrap">
          <img
            src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}${item.image}`}
            alt={item.title}
            class="card-img"
            loading="lazy"
            width="600"
            height="450"
          />
          <span class="category-tag">{item.category}</span>
          <span class="intensity-tag">{item.intensity}</span>
        </div>

        <div class="card-body">
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          
          <ul class="feature-bullets">
            {item.features.map((feat) => (
              <li>
                <Icon name="check" size={18} class="bullet-icon" />
                <span>{feat}</span>
              </li>
            ))}
          </ul>

          <div class="card-footer">
            <button class="btn btn-card" type="button" data-open-modal data-default-class={item.title}>
              Probar gratis
            </button>
            <a href="#horarios" class="link-schedule">
              <span>Ver horarios</span>
              <Icon name="arrow-right" size={15} />
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .card {
    background: var(--white);
    border: 1px solid var(--border-light);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
  }

  .card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 42px rgba(0, 0, 0, 0.1);
    border-color: rgba(214, 47, 15, 0.45);
  }

  .card-image-wrap {
    position: relative;
    height: 240px;
    overflow: hidden;
    background: var(--ink);
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .card:hover .card-img {
    transform: scale(1.06);
  }

  .category-tag {
    position: absolute;
    top: 14px;
    left: 14px;
    background: var(--red);
    color: #fff;
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 6px 12px;
    border-radius: 2px;
  }

  .intensity-tag {
    position: absolute;
    bottom: 14px;
    right: 14px;
    background: rgba(20, 20, 20, 0.88);
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    padding: 6px 12px;
    border-radius: 2px;
    backdrop-filter: blur(4px);
  }

  .card-body {
    padding: 26px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 16px;
  }

  .card h3 {
    font-size: 32px;
    color: var(--ink);
  }

  .card p {
    color: #3E3E3E;
    font-size: 16.5px;
    line-height: 1.6;
  }

  .feature-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 4px;
    padding-top: 16px;
    border-top: 1px solid var(--border-light);
  }

  .feature-bullets li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15.5px;
    color: var(--ink);
    font-weight: 600;
  }

  :global(.bullet-icon) {
    color: var(--red);
    flex-shrink: 0;
  }

  .card-footer {
    margin-top: auto;
    padding-top: 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .btn-card {
    min-height: 44px;
    padding: 10px 22px;
    font-size: 15px;
  }

  .link-schedule {
    font-size: 15.5px;
    font-weight: 700;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color var(--transition), transform var(--transition);
  }

  .link-schedule:hover {
    color: var(--red);
    transform: translateX(3px);
  }
</style>
